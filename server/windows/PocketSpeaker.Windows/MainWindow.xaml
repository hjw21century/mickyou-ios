<Window x:Class="PocketSpeaker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Width="600" Height="820">
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#070B1D"/><GradientStop Color="#171044" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Ellipse Width="320" Height="320" Fill="#28206E" Opacity="0.32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-110,0"/>
    <StackPanel Padding="40" Spacing="20">
      <Grid><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE767;" FontSize="26" Foreground="#55DDF6"/><TextBlock Text="Pocket Speaker" FontSize="24" FontWeight="SemiBold"/></StackPanel><ComboBox x:Name="LanguagePicker" Width="126" Height="36" HorizontalAlignment="Right" SelectionChanged="LanguageChanged"/></Grid>
      <Border Background="#151A36" BorderBrush="#30385F" BorderThickness="1" CornerRadius="28" Padding="34">
        <StackPanel Spacing="22" HorizontalAlignment="Center">
          <Border Width="160" Height="160" CornerRadius="80" Background="#24205A"><FontIcon Glyph="&#xE8EA;" FontSize="66" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="AddressText" Text="将电脑声音无线播放到手机" Foreground="#99A3C7" HorizontalAlignment="Center"/>
          <ComboBox x:Name="DevicePicker" Width="400" Height="44" PlaceholderText="选择电脑输出设备" DisplayMemberPath="Name" SelectionChanged="DeviceChanged"/>
          <ProgressBar x:Name="LevelBar" Width="360" Height="9" Minimum="0" Maximum="1" Value="0" Foreground="#7367FF"/>
          <Button x:Name="ToggleButton" Content="开始共享声音" Width="240" Height="50" HorizontalAlignment="Center" Click="ToggleClicked" Background="#6965FF" Foreground="White" BorderThickness="0" CornerRadius="12"/>
        </StackPanel>
      </Border>
      <Grid><TextBlock x:Name="HistoryTitle" Text="最近连接" FontSize="16" FontWeight="SemiBold"/><Button x:Name="ClearHistoryButton" Content="清空" HorizontalAlignment="Right" Click="ClearHistoryClicked" Background="Transparent" Foreground="#99A3C7"/></Grid>
      <ListView x:Name="HistoryList" Height="105" Background="#101630" BorderBrush="#30385F" BorderThickness="1" CornerRadius="16" DisplayMemberPath="Display"/>
      <TextBlock x:Name="FooterText" Text="无需虚拟声卡 · WASAPI 系统音频捕获 · 局域网传输" Foreground="#6F789C" FontSize="12" HorizontalAlignment="Center"/>
      <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"/>
    </StackPanel>
  </Grid>
</Window>
